{
  "name": "vue_app",
  "version": "1.3.4",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "test:unit": "vitest run",
    "test:unit-watch": "vitest",
    "test:e2e": "vue-cli-service test:e2e --mode development",
    "test:e2e-ci": "vue-cli-service test:e2e --mode development --headless --record --key 100e85d3-fa07-4845-ba30-613180b2a09a",
    "test:smoke": "vite build && playwright test"
  },
  "dependencies": {
    "@mdi/js": "^7.1.96",
    "@sentry/vue": "^7.120.4",
    "apexcharts": "^3.35.3",
    "axios": "^0.34.0",
    "core-js": "^3.6.4",
    "events": "^3.3.0",
    "jquery": "^3.6.3",
    "lodash": "^4.17.15",
    "minidenticons": "^3.1.2",
    "process": "^0.11.10",
    "sass": "^1.105.2",
    "unplugin-vue-components": "^0.22.11",
    "vue": "2.7.16",
    "vue-apexcharts": "1.6.2",
    "vue-demi": "^0.13.11",
    "vue-router": "^3.1.5",
    "vue-template-compiler": "2.7.16",
    "vuetify": "^2.6.14",
    "vuex": "^3.1.3",
    "vuex-router-sync": "^5.0.0",
    "yt-player": "github:travierm/yt-player"
  },
  "devDependencies": {
    "@vue/test-utils": "^1.0.3",
    "babel-eslint": "^10.0.3",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "vite": "^7.3.7",
    "@vitejs/plugin-vue2": "^2.3.4",
    "vitest": "^4.1.11",
    "jsdom": "^26.1.0",
    "@playwright/test": "^1.64.1"
  },
  "resolutions": {
    "vue-demi": "^0.13.11",
    "vite": "^7.3.7"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "babel-eslint"
    },
    "overrides": [
      {
        "files": [
          "**/__tests__/*.{j,t}s?(x)",
          "**/tests/unit/**/*.spec.{j,t}s?(x)"
        ],
        "env": {
          "jest": true
        }
      }
    ]
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ],
  "packageManager": "yarn@1.22.22"
}
