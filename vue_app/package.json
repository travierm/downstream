{
  "name": "vue_app",
  "version": "1.3.4",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "serve": "vite preview",
    "test:unit": "vitest run",
    "test:unit-watch": "vitest",
    "test:e2e": "playwright test",
    "test:smoke": "pnpm build && playwright test"
  },
  "dependencies": {
    "@mdi/js": "^7.1.96",
    "@sentry/vue": "^11.8.0",
    "apexcharts": "^5.16.0",
    "axios": "^0.34.0",
    "core-js": "^3.6.4",
    "events": "^3.3.0",
    "jquery": "^3.6.3",
    "lodash": "^4.17.15",
    "minidenticons": "^3.1.2",
    "process": "^0.11.10",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vuetify": "^4.2.6",
    "vuex": "^4.1.0",
    "yt-player": "github:travierm/yt-player",
    "vue3-apexcharts": "^1.11.3"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.5.1",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "jsdom": "^26.1.0",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "vite-plugin-vuetify": "^2.1.3",
    "sass": "^1.105.2",
    "@vue/compiler-dom": "^3.5.44",
    "@vue/compiler-sfc": "^3.5.44"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "overrides": [
      {
        "files": [
          "**/__tests__/*.{j,t}s?(x)",
          "**/tests/unit/**/*.spec.{j,t}s?(x)"
        ],
        "env": {
          "jest": true
        }
      }
    ]
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ],
  "packageManager": "pnpm@11.20.0"
}
